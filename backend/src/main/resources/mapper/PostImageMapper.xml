<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.raisetime.mapper.PostImageMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO post_images (post_id, s3_key, position)
        VALUES (#{postId}, #{s3Key}, #{position})
    </insert>

    <select id="findByPostIds" resultType="com.example.raisetime.entity.PostImage">
        SELECT id, post_id, s3_key, position, created_at
        FROM post_images
        WHERE post_id IN
        <foreach collection="list" item="postId" open="(" separator="," close=")">
            #{postId}
        </foreach>
        ORDER BY post_id, position
    </select>

    <delete id="deleteByIds">
        DELETE FROM post_images
        WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="updatePosition">
        UPDATE post_images SET position = #{position} WHERE id = #{id}
    </update>

    <!--
        編集（F-10）で表示順を並べ替えるとき、1件ずつ更新すると途中で表示順が重なる（例：1番と2番の入れ替え）。
        このトランザクションの間だけ、重なりのチェックをコミット時まで遅らせる（制約は V8 で DEFERRABLE にしてある）
    -->
    <update id="deferPositionCheck">
        SET CONSTRAINTS uq_post_images_post_position DEFERRED
    </update>

</mapper>
